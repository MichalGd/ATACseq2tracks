#!/usr/bin/env bash
set -euo pipefail

LAUNCHER_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
[[ -n "$LAUNCHER_PATH" && -f "$LAUNCHER_PATH" ]] || {
    echo "ERROR: cannot resolve launcher path: ${BASH_SOURCE[0]}" >&2
    exit 1
}
INSTALL_DIR="$(cd "$(dirname "$LAUNCHER_PATH")/.." && pwd -P)"
MAIN_ENV="${ATACSEQ2TRACKS_MAIN_ENV:-/opt/miniconda/envs/ATACseq2tracks}"
ATAQV_ENV="${ATACSEQ2TRACKS_ATAQV_ENV:-/opt/miniconda/envs/ataqv-tools}"

unset PYTHONHOME PYTHONPATH R_HOME R_LIBS R_LIBS_USER
path_parts=()
[[ -d "${MAIN_ENV}/bin" ]] && path_parts+=("${MAIN_ENV}/bin")
[[ -d "${ATAQV_ENV}/bin" ]] && path_parts+=("${ATAQV_ENV}/bin")
path_parts+=("/usr/local/bin" "/usr/bin" "/bin")
export PATH="$(IFS=:; echo "${path_parts[*]}")"

exec bash "${INSTALL_DIR}/atacseq2tracks.sh" "$@"
