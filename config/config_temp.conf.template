#!/usr/bin/env bash
# =============================================================================
# ATACseq2tracks v3.0.4 — Configuration template
# https://github.com/<username>/ATACseq2tracks
#
# INSTRUCTIONS:
#   1. Copy this file to your project directory:
#        cp config.conf.template /path/to/myproject/config.conf
#   2. Fill in all REQUIRED fields (marked with ### REQUIRED ###)
#   3. Adjust thread counts to match your server
#   4. Run:
#        bash /path/to/ATACseq2tracks/atacseq2tracks.sh --config /path/to/myproject/config.conf
#
# This file should NOT contain real paths from your server.
# Keep your personal config.conf in your project directory, NOT in the repo.
# Add config.conf to .gitignore if storing project dirs under version control.
# =============================================================================

# ── PER-RUN settings — EDIT THESE BEFORE EVERY RUN ──────────────────────────

# ### REQUIRED ### Absolute path to your samplesheet CSV for this run
SAMPLESHEET="/path/to/your/project/config/samplesheet.csv"

# ### REQUIRED ### Absolute path to output directory (created automatically)
OUTPUT_DIR="/path/to/your/project/ATACseq2tracks/"

# Max parallel samples per batch stage
# Recommended: number of physical CPU cores / 4 (to leave room for multi-thread jobs)
# Safe default for most servers: 4-8
THREADS_PARALLEL_JOBS=4

# ── Reference genome indices (Bowtie2) ───────────────────────────────────────
# ### REQUIRED ### Path to Bowtie2 index prefix (without .bt2 extension)
# Only fill in the genomes you will actually use.

INDEX_HG38="/path/to/bowtie2/indices/hg38"
INDEX_MM39="/path/to/bowtie2/indices/mm39"

# ── Reference annotation files ───────────────────────────────────────────────
# GENCODE GTF files (used by downstream analysis, not alignment itself)
GTF_HUMAN="/path/to/gencode.v42.primary_assembly.annotation.gtf"
GTF_MOUSE="/path/to/gencode.vM31.primary_assembly.annotation.gtf"

# Chromosome sizes files (required for bedGraphToBigWig)
# Generate with: samtools view -H sample.bam | grep @SQ | awk '{print $2"\t"$3}' | sed 's/SN://;s/LN://' > genome.chrom.sizes
# Or download from UCSC: https://hgdownload.soe.ucsc.edu/goldenPath/hg38/bigZips/hg38.chrom.sizes
CHROM_SIZES_HUMAN="/path/to/hg38.chrom.sizes"
CHROM_SIZES_MOUSE="/path/to/mm39.chrom.sizes"

# ── Blacklist regions ─────────────────────────────────────────────────────────
# ENCODE blacklists — download from:
#   hg38: https://www.encodeproject.org/files/ENCFF356LFX/
#   mm39: https://github.com/Boyle-Lab/Blacklist/tree/master/lists
BLACKLIST_HG38="/path/to/blacklist_hg38_ENCFF356LFX.bed"
BLACKLIST_MM39="/path/to/blacklist_mm39_Boyle.bed"

# ── ChIPQC annotation files (optional — only needed if using run_chipqc.R) ───
# Pre-built RDS objects from AnnotationHub. Leave as-is if not using ChIPQC.
# See: https://bioconductor.org/packages/release/bioc/html/ChIPQC.html
CHIPQC_ANNOTATION_HG38="/path/to/anno_hg38_chipqc.rds"
CHIPQC_ANNOTATION_MM39="/path/to/anno_mm39_chipqc.rds"
CHIPQC_BLACKLIST_HG38_RDS="/path/to/blacklist_hg38.rds"
CHIPQC_BLACKLIST_MM39_RDS="/path/to/blacklist_mm39.rds"

# ── Software paths ────────────────────────────────────────────────────────────

# ### REQUIRED ### Path to picard.jar
# Download: https://github.com/broadinstitute/picard/releases
PICARD_JAR="/path/to/picard.jar"

# Picard JVM memory — adjust to available RAM (e.g. -Xmx16G for 16 GB)
PICARD_XMX="-Xmx16G"

# Optical duplicate pixel distance
# 100 = HiSeq (patterned flowcell: use 2500)
# 2500 = NovaSeq / NextSeq
PICARD_OPTICAL_DISTANCE=100

# Temp directory for Picard (must have sufficient space, typically /tmp or scratch)
PICARD_TMP="/tmp/picard_tmp"

# ### REQUIRED ### Path to UCSC bedGraphToBigWig binary
# Download: https://hgdownload.soe.ucsc.edu/admin/exe/linux.x86_64/bedGraphToBigWig
BEDGRAPH_TO_BIGWIG="/path/to/kentutils/bedGraphToBigWig"

# R binary (usually just "Rscript" if R is in PATH)
R_BIN="Rscript"

# Optional: path to conda environment activate script
# Example: "/home/user/miniconda3/etc/profile.d/conda.sh"
# Leave empty if your conda environment is already active before launching
CONDA_ENV_ACTIVATE=""

# ── MACS2 peak calling parameters ────────────────────────────────────────────
# Genome size shortcuts used by MACS2 (-g flag)
MACS2_GENOME_HG38="hs"
MACS2_GENOME_MM39="mm"

# q-value cutoff for narrow peaks (default: 0.05)
MACS2_QVALUE=0.05

# p-value cutoff for broad peaks (default: 0.1)
MACS2_BROAD_CUTOFF=0.1

# ── Thread / CPU settings ─────────────────────────────────────────────────────
# Tune to your server. Total concurrent threads ≈ THREADS_PARALLEL_JOBS × max(thread values below)
# For a 16-core workstation: align=8, samtools=8, others=4
# For a 64-core server: align=16, samtools=16, others=8-16

THREADS_ALIGN=8           # bowtie2 threads per sample
THREADS_SAMTOOLS=8        # samtools threads per sample
THREADS_FASTQC=4          # FastQC parallel files
THREADS_TRIMGALORE=4      # Trim Galore cores per sample
THREADS_BIGWIG=8          # bedtools / bedGraphToBigWig threads
THREADS_DEEPTOOLS=8       # deepTools threads (Phase 2/3 QC, Step 10)
THREADS_CHIPQC=8          # ChIPQC R threads (legacy, Step 10 old)

# ── UCSC Genome Browser track URL ────────────────────────────────────────────
# Base HTTP/HTTPS URL where your bigWig files will be served publicly
# Used by create_ucsc_tracks.sh to generate track hub lines
# Example: "https://myserver.institution.edu/chipseq/run1/bigwig"
# Leave empty to skip UCSC track generation
UCSC_BASE_URL=""

# ── Storage cleanup ───────────────────────────────────────────────────────────
# Set to "true" to KEEP the files after pipeline completion.
# Default: delete all intermediate files to save disk space.
# Set KEEP_FILTERED_BAMS=true if you plan to run DiffBind downstream.

KEEP_INTERMEDIATE_BAMS=false   # bams/        aligned, pre-dedup BAMs (~5 GB/sample)
KEEP_TRIMMED_FASTQ=false       # trimmedFastq/ trimmed reads (~3 GB/sample)
KEEP_DEDUP_BAMS=false          # dedupBams/   deduplicated BAMs (~4 GB/sample)
KEEP_FILTERED_BAMS=false       # filteredBams/ blacklist-filtered BAMs (~3.5 GB/sample)
KEEP_RAW_BEDGRAPH=false        # bedGraph/    unnormalised bedGraphs (redundant with bigWig)
