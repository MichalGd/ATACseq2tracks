#!/usr/bin/env bash
# =============================================================================
# ATACseq2tracks v4.0.0 - main configuration template
#
# This is the ONLY file you need to edit before each run.
# It can live ANYWHERE on the server (your project folder).
#
# Usage:
#   bash /path/to/ATACseq2tracks/atacseq2tracks.sh --config /path/to/config.conf
#
# All run-specific settings — samplesheet, output dir, and resources —
# are defined here. No other arguments are needed at the command line.
# =============================================================================

# ── PER-RUN settings — change these before every run ─────────────────────────

# Absolute path to your samplesheet for this run
SAMPLESHEET="/path/to/project/config/samplesheet.csv"

# Absolute path to the output directory (will be created if it does not exist)
OUTPUT_DIR="/path/to/project/results/atacseq_run1"

# Max parallel samples per early batch stage (tune to server load)
THREADS_PARALLEL_JOBS=8

# Later-stage bounded parallelism. These are independent, user-configurable
# limits. Defaults are conservative for large BAM files and shared storage.
QC_SAMPLE_PARALLEL_JOBS=4
ATAQV_PARALLEL_JOBS=4
TRACK_PARALLEL_JOBS=2
POOLED_MACS_PARALLEL_JOBS=2
MERGE_PARALLEL_JOBS=2

# ── Server-wide reference data ── shared paths; change only if data moves ────

INDEX_HG38="/path/to/references/hg38/bowtie2/hg38"
INDEX_MM39="/path/to/references/mm39/bowtie2/mm39"

GTF_HUMAN="/path/to/references/hg38/annotation.gtf"
CHROM_SIZES_HUMAN="/path/to/references/hg38/hg38.chrom.sizes"
GTF_MOUSE="/path/to/references/mm39/annotation.gtf"
CHROM_SIZES_MOUSE="/path/to/references/mm39/mm39.chrom.sizes"

# Regulatory annotations used by the built-in simple peak annotation. cCRE
# classification is enabled by default below; provide genome-matched files or
# set RUN_CCRE_ANNOTATION=false for GTF-only annotation. Do not mix builds.
# Human: ENCODE4 expanded Registry, native GRCh38 BED.
# Prepare with: bash utilities/prepare_encode4_hg38_ccre.sh
CCRE_BED_HG38="/home/micgdu/Analysis/utilities/UCSC/CREs/human/hg38/Supplementary-Data-1.GRCh38-cCREs-V4.bed.gz"
CCRE_SOURCE_HG38="ENCODE4_GRCh38_2026"
# Mouse: the ATAC-seq utilities ENCODE3 mm10 registry lifted to mm39.
CCRE_BED_MM39="/home/micgdu/Analysis/utilities/UCSC/CREs/mouse/mm39/encodeCcreCombined_mm39_sorted.bed"
CCRE_SOURCE_MM39="ENCODE3_mm10_liftOver_mm39"

BLACKLIST_HG38="/path/to/references/hg38/hg38.blacklist.bed"
BLACKLIST_MM39="/path/to/references/mm39/mm39.blacklist.bed"

# Optional pre-built, strand-aware BED6 TSS files. Leave empty to generate them
# from the corresponding GTF once per run.
TSS_BED_HG38=""
TSS_BED_MM39=""

# ── Retired ChIPQC settings ─────────────────────────────────────────────────
# ChIPQC settings were removed in v4.0.0; Step 10 uses deepTools and DESeq2.

# ── Software paths ────────────────────────────────────────────────────────────
PICARD_JAR="/path/to/software/picard.jar"
PICARD_XMX="-Xmx32G"
PICARD_OPTICAL_DISTANCE=100
PICARD_TMP="/tmp/picard_tmp"
BEDGRAPH_TO_BIGWIG="/path/to/software/bedGraphToBigWig"
R_BIN="Rscript"
CONDA_ENV_ACTIVATE=""   # leave empty if conda env is already active

# ── MACS3 parameters ─────────────────────────────────────────────────────────
MACS3_GENOME_HG38="hs"
MACS3_GENOME_MM39="mm"
MACS3_QVALUE=0.05
MACS3_BROAD_CUTOFF=0.1
MACS3_COMMAND="macs3"
MACS3_ATAC_SE_SHIFT=-75
MACS3_ATAC_SE_EXTSIZE=150
ALLOW_EMPTY_PEAKS=false

# Core alignment and filtering policy
BOWTIE2_EXTRA_ARGS="--very-sensitive"
TRIMGALORE_EXTRA_ARGS=""
MIN_MAPQ=30
REMOVE_MITO=true
ALLOW_EMPTY_FILTERED_BAM=false
# Mixed genome builds are rejected in v4.0.0; run them separately.

# Consensus support counts distinct biological sample keys after technical
# replicates are collapsed. No one-sample union fallback is used by default.
CONSENSUS_PEAK_TYPE="narrow"
CONSENSUS_MIN_SAMPLES=2
ALLOW_SINGLE_SAMPLE_CONSENSUS=false
GENERATE_DESEQ2_CONSENSUS_TRACKS=true

# Differential accessibility. DiffBind uses a 201-bp summit-centred window by
# default; set DIFFBIND_SUMMITS=200 to reproduce the previous 401-bp behavior.
DIFFBIND_SUMMITS=100
DIFFBIND_ALPHA=0.05

# Any number of condition names is supported. Conditions with fewer than two
# biological samples contribute to consensus construction and descriptive
# counts, but are excluded from statistical models. Every pair of remaining
# conditions is extracted from one multi-condition model per method/peak type.
# By default, direction follows first appearance in the samplesheet: the later
# condition is the numerator. Optionally provide a comma-separated full or
# partial order, for example "stem,prolif,Day4,Day7".
DIFFERENTIAL_CONDITION_ORDER=""
DIFFERENTIAL_MIN_ABS_LOG2FC=0

# DESeq2ATAC runs independent broad- and narrow-peak analyses. Each peak type
# gets its own replicate-supported consensus and DESeq2 model. It requires
# macs2_mode=both for every non-control sample. The default model is ~ condition.
# Set the optional block column only when it is present in the samplesheet and
# not confounded with condition (for example, batch or donor).
RUN_DESEQ2ATAC=true
DESEQ2ATAC_MIN_SAMPLES=2
DESEQ2ATAC_ALPHA=0.05
DESEQ2ATAC_BLOCK_COLUMN=""
DESEQ2ATAC_REFERENCE_CONDITION=""

# Browser tracks: fragment/read CPM is generated first; DESeq2 consensus and
# robust CPM bigWig/bedGraph tracks follow consensus size-factor estimation.
TRACK_BIN_SIZE=10
# SE libraries use one filtered alignment as one observation. A physical
# fragment cannot be reconstructed from an SE read. Tn5 mode is not yet implemented.
SE_SIGNAL_MODE="read"
# Required for a shared canonical autosome/X/Y universe across all track types.
TRACK_STANDARD_CHROMS_ONLY=true
BAMCOVERAGE_COMMON_ARGS=""
UCSC_BIGDATA_URL_BASE=""
UCSC_TRACK_PREFIX="ATAC-seq"

# Optional biological interpretation; requires HOMER commands in PATH.
RUN_PEAK_ANNOTATION=false
RUN_MOTIF_ENRICHMENT=false
HOMER_GENOME_HG38="hg38"
HOMER_GENOME_MM39="mm39"
THREADS_MOTIF=4

# Built-in annotation of differential peak universes and result tables. This
# uses existing Bioconductor dependencies, not HOMER. Gene context is derived
# from the configured GTF. cCRE classification is required by default; users
# without the reference can retain GTF annotation by setting the switch false.
RUN_SIMPLE_PEAK_ANNOTATION=true
RUN_CCRE_ANNOTATION=true
PEAK_ANNOTATION_PROMOTER_UPSTREAM=2000
PEAK_ANNOTATION_PROMOTER_DOWNSTREAM=500

# ATAC-specific QC. ataqv calculates ENCODE-style TSS enrichment and its
# short-to-mononucleosomal ratio. PE samples additionally receive compact
# fragment-bin metrics and 300-dpi/PDF fragment-periodicity plots.
RUN_ATAQV_QC=true
GENERATE_ATAQV_VIEWER=true
ATAQV_TSS_EXTENSION=1000
FRAGMENT_PLOT_MAX_BP=1000
THREADS_ATAQV=8

# ── Thread settings (server: 70 physical / 140 logical / 500 GB RAM) ─────────
THREADS_ALIGN=16
THREADS_SAMTOOLS=16
THREADS_FASTQC=10
THREADS_TRIMGALORE=8
THREADS_BIGWIG=16

# deepTools workers — used by Step 10 (post_alignment_qc_batch.sh)
# multiBamSummary, bamCoverage, computeMatrix all respect this value
THREADS_DEEPTOOLS=16

# ── Cleanup ───────────────────────────────────────────────────────────────────
# Cleanup runs only after the complete workflow succeeds. Set false to retain
# every intermediate for troubleshooting or planned partial-stage reruns.
ENABLE_AUTOMATIC_CLEANUP=true
KEEP_INTERMEDIATE_BAMS=false
KEEP_TRIMMED_FASTQ=false
KEEP_DEDUP_BAMS=false
KEEP_FILTERED_BAMS=true
KEEP_RAW_BEDGRAPH=false
