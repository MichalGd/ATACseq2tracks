#!/usr/bin/env bash
# =============================================================================
# ATACseq2tracks v3.2.0 - main configuration template
#
# This is the ONLY file you need to edit before each run.
# It can live ANYWHERE on the server (your project folder).
#
# Usage:
#   bash /path/to/ATACseq2tracks/atacseq2tracks.sh --config /path/to/config.conf
#
# All run-specific settings — samplesheet, output dir, and resources —
# are defined here. No other arguments are needed at the command line.
# =============================================================================

# ── PER-RUN settings — change these before every run ─────────────────────────

# Absolute path to your samplesheet for this run
SAMPLESHEET="/path/to/project/config/samplesheet.csv"

# Absolute path to the output directory (will be created if it does not exist)
OUTPUT_DIR="/path/to/project/results/atacseq_run1"

# Max parallel samples per batch stage (tune to server load; 8 is safe default)
THREADS_PARALLEL_JOBS=8

# ── Server-wide reference data ── shared paths; change only if data moves ────

INDEX_HG38="/path/to/references/hg38/bowtie2/hg38"
INDEX_MM39="/path/to/references/mm39/bowtie2/mm39"

GTF_HUMAN="/path/to/references/hg38/annotation.gtf"
CHROM_SIZES_HUMAN="/path/to/references/hg38/hg38.chrom.sizes"
GTF_MOUSE="/path/to/references/mm39/annotation.gtf"
CHROM_SIZES_MOUSE="/path/to/references/mm39/mm39.chrom.sizes"

BLACKLIST_HG38="/path/to/references/hg38/hg38.blacklist.bed"
BLACKLIST_MM39="/path/to/references/mm39/mm39.blacklist.bed"

# Optional pre-built, strand-aware BED6 TSS files. Leave empty to generate them
# from the corresponding GTF once per run.
TSS_BED_HG38=""
TSS_BED_MM39=""

# ── Retired ChIPQC settings ─────────────────────────────────────────────────
# ChIPQC settings were removed in v3.2.0; Step 10 uses deepTools and DESeq2.

# ── Software paths ────────────────────────────────────────────────────────────
PICARD_JAR="/path/to/software/picard.jar"
PICARD_XMX="-Xmx32G"
PICARD_OPTICAL_DISTANCE=100
PICARD_TMP="/tmp/picard_tmp"
BEDGRAPH_TO_BIGWIG="/path/to/software/bedGraphToBigWig"
R_BIN="Rscript"
CONDA_ENV_ACTIVATE=""   # leave empty if conda env is already active

# ── MACS3 parameters ─────────────────────────────────────────────────────────
MACS3_GENOME_HG38="hs"
MACS3_GENOME_MM39="mm"
MACS3_QVALUE=0.05
MACS3_BROAD_CUTOFF=0.1
MACS3_COMMAND="macs3"
MACS3_ATAC_SE_SHIFT=-75
MACS3_ATAC_SE_EXTSIZE=150
ALLOW_EMPTY_PEAKS=false

# Core alignment and filtering policy
BOWTIE2_EXTRA_ARGS="--very-sensitive"
TRIMGALORE_EXTRA_ARGS=""
MIN_MAPQ=30
REMOVE_MITO=true
ALLOW_EMPTY_FILTERED_BAM=false
# Mixed genome builds are rejected in v3.2.0; run them separately.

# Consensus support counts distinct biological sample keys after technical
# replicates are collapsed. No one-sample union fallback is used by default.
CONSENSUS_PEAK_TYPE="narrow"
CONSENSUS_MIN_SAMPLES=2
ALLOW_SINGLE_SAMPLE_CONSENSUS=false
GENERATE_DESEQ2_CONSENSUS_TRACKS=true

# Browser tracks: RPM is generated first; DESeq2 consensus-peak scaling is
# generated after the consensus count matrix and size factors are available.
TRACK_BIN_SIZE=10
TRACK_STANDARD_CHROMS_ONLY=true
BAMCOVERAGE_COMMON_ARGS=""
UCSC_BIGDATA_URL_BASE=""
UCSC_TRACK_PREFIX="ATAC-seq"

# Optional biological interpretation; requires HOMER commands in PATH.
RUN_PEAK_ANNOTATION=false
RUN_MOTIF_ENRICHMENT=false
HOMER_GENOME_HG38="hg38"
HOMER_GENOME_MM39="mm39"
THREADS_MOTIF=4

# ATAC-specific QC. ataqv calculates ENCODE-style TSS enrichment and its
# short-to-mononucleosomal ratio. PE samples additionally receive compact
# fragment-bin metrics and 300-dpi/PDF fragment-periodicity plots.
RUN_ATAQV_QC=true
GENERATE_ATAQV_VIEWER=true
ATAQV_TSS_EXTENSION=1000
FRAGMENT_PLOT_MAX_BP=1000
THREADS_ATAQV=8

# ── Thread settings (server: 70 physical / 140 logical / 500 GB RAM) ─────────
THREADS_ALIGN=16
THREADS_SAMTOOLS=16
THREADS_FASTQC=10
THREADS_TRIMGALORE=8
THREADS_BIGWIG=16

# deepTools workers — used by Step 10 (post_alignment_qc_batch.sh)
# multiBamSummary, bamCoverage, computeMatrix all respect this value
THREADS_DEEPTOOLS=16

# ── Cleanup ───────────────────────────────────────────────────────────────────
ENABLE_AUTOMATIC_CLEANUP=false
KEEP_INTERMEDIATE_BAMS=false
KEEP_TRIMMED_FASTQ=false
KEEP_DEDUP_BAMS=false
KEEP_FILTERED_BAMS=true
KEEP_RAW_BEDGRAPH=false
